# Local development values (used when running `python run.py` on your machine).
# On Railway, do NOT set these manually — instead add a MySQL database plugin
# to your Railway project and it will automatically inject MYSQL_URL /
# MYSQLHOST / MYSQLUSER / MYSQLPASSWORD / MYSQLDATABASE / MYSQLPORT, which
# app/config.py reads automatically. These DB_* values are only the local fallback.
DB_NAME=inventoryhub_db
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me

# Any random long string works. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me
# Access token lifetime, in minutes
JWT_TIMEOUT=15
